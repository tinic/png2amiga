  "baseline_commit": "40b8712efdd6d00bee188e0600412cd2dfd663cf",
  "baseline_note": "EHB encoder unchanged at the start of this experiment; binary preserved before EHB edits. DPF improvements were already present but are not used in this mode.",
  "flags": [
    "--mode",
    "ehb",
    "--strips",
    "--width",
    "320",
    "--height",
    "200"
  ],
  "metric": "SSIMULACRA2 (S2), higher is better; CLI reports two decimals",
  "corpus": "All 23 PNG/JPEG/WebP specimens directly in examples/; subdirectories excluded",
  "changes": {
    "dedup": "One deterministic outer pass; actual RGB444 candidate keys; half-bound candidates invert the hardware nibble shift instead of doubling OKLab.",
    "lookahead": "dedup + two-strip future candidates and discounted lookahead (0.6, 0.3), two-state beam. No boundary guard yet.",
    "refined": "lookahead + four register-lifetime fit iterations with exhaustive joint base/half-brite RGB444 search; three-pixel boundary guard; preserve schedule and hardware state on row fallback.",
    "beam8": "refined with eight beam states; rejected because lower mean S2 and greater runtime.",
    "final": "Two-state refined version; suppress midline swaps when fewer than two base registers are selectable so boundary guards always have an alternative. Widened EHB guard to seven pixels after user reported remaining artifacts; tolerates three-pixel early/late landings. Maui reproduced right-edge corruption: delay EHB EOL from $DD to $E1, preserve the later wait across line 255, and honor the default COLOR00 black-border lock in the midline planner."
  },
  "constraints": "32 base registers + 32 hardware half-brites; unchanged visible EHB slot positions; EOL delayed to $E1; at most 13 hblank and 18 visible MOVEs per line. Initial sliced palettes remain fixed; final values equal to the next line entry are preserved during refinement.",
  "outcome": {
    "mean_delta_s2": 2.426956521739129,
    "wins": 22,
    "ties": 0,
    "losses": 1,
    "regression": "photo.jpg: 62.47 -> 60.98 (-1.49)"
  },
  "validation": {
    "ctest": "46/46 passed: EHB tests plus DPF replay, including Maui at 320x160, +/-3-pixel EHB landings, black-border invariance and 249-row wrap.",
    "replay": "Exact exported-bitplane/copper-to-preview equality, including \u00b13 pixel landings, 249-row vertical wrap, DBS, reserved registers, one selectable base register, and reduced change budget. Hblank and visible write limits asserted.",
    "emulator": "Reproduced black marks at Maui right edge with seven-pixel guard. Changing EOL to $E1 removed those marks; locking COLOR00 removed colored right/bottom borders. Built and inspected production maui-fixed at 320x160 in Amiberry A1200: clean edge and black border. User confirmed maui-fixed removes the artifacts. Not physical hardware validation.",
    "wasm": "Not rebuilt; configured Emscripten toolchain is missing"
  },
