# target to build an object file
src/strips.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/png2amiga.dir/build.make CMakeFiles/png2amiga.dir/src/strips.cpp.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/api_pipeline_smoke.dir/build.make CMakeFiles/api_pipeline_smoke.dir/src/strips.cpp.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/palette_search.dir/build.make CMakeFiles/palette_search.dir/src/strips.cpp.o
.PHONY : src/strips.cpp.o

