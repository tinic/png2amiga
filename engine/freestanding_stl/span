// Freestanding <span> shim — minimal std::span<T> for -nostdlib builds.
// Only the constructors + accessors the engine uses; no extents, no
// subspan, no reverse iterators.
#pragma once
#include <cstddef>

namespace std {

inline constexpr size_t dynamic_extent = static_cast<size_t>(-1);

template <class T, size_t Extent = dynamic_extent>
class span {
    T* _ptr{};
    size_t _n{};
public:
    constexpr span() noexcept = default;
    constexpr span(T* p, size_t n) noexcept : _ptr(p), _n(n) {}
    template <size_t N>
    constexpr span(T (&arr)[N]) noexcept : _ptr(arr), _n(N) {}

    constexpr T* data() const noexcept    { return _ptr; }
    constexpr size_t size() const noexcept { return _n; }
    constexpr bool empty() const noexcept { return _n == 0; }

    constexpr T& operator[](size_t i) const noexcept { return _ptr[i]; }

    constexpr T* begin() const noexcept { return _ptr; }
    constexpr T* end()   const noexcept { return _ptr + _n; }
};

} // namespace std
