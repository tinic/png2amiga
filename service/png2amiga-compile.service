[Unit]
Description=png2amiga compile service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/www/png2amiga/service/compile.py
WorkingDirectory=/var/www/png2amiga
Restart=on-failure
RestartSec=5

# Security hardening
#
# Runs as a dedicated static system user, NOT DynamicUser=yes.
# DynamicUser forces RestrictSUIDSGID=yes (cannot be turned off), and
# that seccomp filter answers openat2() with ENOSYS because it cannot
# inspect the open_how struct. bubblewrap >= 0.12 opens every bind
# source with openat2() and has no fallback, so every compile died with
#   bwrap: Can't open source /usr: Function not implemented
# (GitHub issue #16). The properties below are what DynamicUser implied,
# minus RestrictSUIDSGID. Do not add RestrictSUIDSGID= or a
# SystemCallFilter= that denies openat2 here.
#
# One-time setup on the server:
#   useradd --system --no-create-home --shell /usr/sbin/nologin png2amiga-compile
User=png2amiga-compile
Group=png2amiga-compile
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RemoveIPC=yes
NoNewPrivileges=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
