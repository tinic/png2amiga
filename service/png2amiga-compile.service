[Unit]
Description=png2amiga compile service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/www/png2amiga/service/compile.py
WorkingDirectory=/var/www/png2amiga
Restart=on-failure
RestartSec=5

# Security hardening
DynamicUser=yes
ProtectHome=yes
NoNewPrivileges=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
