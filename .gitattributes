# Force LF endings on everything checked out to a server / Linux build:
# the compile service runs on Debian and its working tree is updated by
# `git pull`, which trips over Windows-checkout CRLF files (deploy sees
# them as locally-modified and refuses to fast-forward — has bitten the
# server at least once, see commit history for service/compile.py).
*.py    text eol=lf
*.sh    text eol=lf
*.conf  text eol=lf
*.service text eol=lf
nginx.conf text eol=lf

# Source code: standard text handling, but normalize on commit and
# ensure cross-platform git-blame stays sane.
*.c     text
*.h     text
*.cpp   text
*.hpp   text
*.inc   text
*.md    text
*.json  text
*.ts    text
*.js    text
*.mjs   text
*.vue   text
*.yml   text
*.yaml  text
*.toml  text
*.cmake text
CMakeLists.txt text

# Binary blobs we don't want git to "normalize."
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.iff   binary
*.adf   binary
*.exe   binary
*.bin   binary
*.wasm  binary
*.gz    binary
*.br    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
